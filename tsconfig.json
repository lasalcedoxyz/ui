{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/lib/*": ["registry/kotlerui/lib/*"],
      "@/hooks/*": ["registry/kotlerui/hooks/*"],
      "@/components/ui/*": ["registry/kotlerui/ui/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
