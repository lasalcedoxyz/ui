---
import "../styles/global.css"
import { Font } from "astro:assets";

import { NavbarSimple } from "@/registry/kotlerui/components/navbar/navbar-simple"; 
import { Button } from "@/components/ui/button";

const navMenu = [
  {
    id: "components",
    label: "Components",
    href: "/components",
  },
  {
    id: "blocks",
    label: "Blocks",
    href: "/blocks",
  },
  {
    id: "templates",
    label: "Templates",
    href: "/templates",
  },
  {
    id: "tools",
    label: "Tools",
    href: "/tools",
  },
  {
    id: "mcp",
    label: "MCP",
    href: "/mcp",
  },
  {
    id: "pricing",
    label: "Pricing",
    href: "/pricing",
  },
];

const actions = [
  {
    id: "login",
    label: "Log in",
    href: "/login",
    variant: "outline" as const,
  },
  {
    id: "signup",
    label: "Get started",
    href: "/signup",
    variant: "default" as const,
  },
];

const {
  title,
  description
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name=""/>
    <!-- OG Meta-->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <Font cssVariable="--font-sans" preload/>
  </head>
  <body class="min-h-dvh flex flex-col">
    <NavbarSimple 
      logo="kotlerui"
      links={navMenu} 
      actions={actions}
      className="fixed"
      client:load
    />
    <slot/> 
  </body>
</html>
