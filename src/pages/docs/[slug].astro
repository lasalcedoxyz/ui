---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('doc');
  return docs.map(doc => ({
    params: { slug: doc.data.slug },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
---

<Content/>