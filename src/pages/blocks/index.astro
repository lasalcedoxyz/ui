---
import { getCollection, getEntry } from 'astro:content';
import Layout from "../../layouts/Layout.astro";

const blocks = await getCollection('block');
---

<Layout> 
<div>
    <h2>Blocks</h2>
    {blocks.map(block => (
        <div class="w-full min-h-50 border rounded-md">
            <p>{block.data.name}</p>
        </div>
    ))}
</div>
</Layout>
