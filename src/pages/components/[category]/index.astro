---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
  const categories = await getCollection('category');
  const components = await getCollection('component');

  return categories.map((category) => ({
    params: {
      category: category.data.id,
    },
    props: {
      category,
      components: components.filter(
        (component) => component.data.category.id === category.id,
      ),
    },
  }));
}

const { category, components } = Astro.props;
---

<Layout>
  <h1>{category.data.label}</h1>
{components.map((component) => (
  <a href={component.data.category.id}>{component.data.name}</a>
))}
</Layout>
